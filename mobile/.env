# Expo Environment Variables
# These variables will be compiled into the frontend code via EXPO_PUBLIC_ prefix

EXPO_PUBLIC_API_URL=https://apostle-snippet-freeness.ngrok-free.dev/api/v1

# Google Auth Client IDs
# Web Client ID is used for Expo Go development

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1061563224664-ca0tqeophsi3tvjv0e7eq28177cbu8p6.apps.googleusercontent.com

# Android and iOS Client IDs are used for native standalone builds
# These should be generated in the Google Cloud Console (see docs/GOOGLE_AUTH_SETUP.md)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=1061563224664-rg9pc8ed1s1anje1gmn2sdhchlk4gv61.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1061563224664-f3r1nnp8rkla1kb72uujdu457itusldl.apps.googleusercontent.com
